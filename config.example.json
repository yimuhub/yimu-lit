{
  "version": "1.4.0",
  "port": 46821,
  "skill_path": "skill",
  "llm": {
    "base_url": "https://api.agnes-ai.cn/v1",
    "api_key": "",
    "model": "agnes-2.5-flash",
    "temperature": 0.85,
    "max_tokens": 12000,
    "timeout": 900
  },
  "defaults": {
    "chapters": 10,
    "min_words": 3000,
    "max_expand_retries": 3,
    "v3_pipeline": true,
    "validation": {
      "enabled": true,
      "mode": "report",
      "max_fix_rounds": 2,
      "pass_line": 90
    },
    "stage_models": {
      "planning": {},
      "writing": {},
      "review": {}
    },
    "use_prefix_cache": true,
    "p5_pipeline": true,
    "reader_panel": false,
    "call_gap": 2,
    "llm_timeout": 900,
    "planning_timeout": 1200,
    "release_gate": true,
    "max_release_rounds": 3,
    "title_count": 8,
    "max_release_rewrite": 3,
    "chapter_workers": 2,
    "chapter_workers_note": "并行分章写作的默认并发数（1-8，协作面板可临时覆盖）；由 app.py 的 /api/parallel-write 读取",
    "max_global_agents": 4,
    "agent_skills": {},
    "token_budget": 0,
    "lorebook": true,
    "llm_trace": true,
    "llm_cache": false,
    "longform": {
      "enabled": true,
      "scale": "3m",
      "mode": "rolling",
      "replan_every": 10,
      "context_budget": 24000,
      "volume_chapters": 40,
      "arc_chapters": 10,
      "window_chapters": 12
    },
    "references": {
      "enabled": true,
      "max_refs": 200,
      "max_chars_per_ref": 2000000,
      "chunk_size": 1200,
      "chunk_overlap": 150,
      "retrieve_k": 6,
      "context_chars": 4000,
      "overlap_n": 12
    },
    "skill_evolution": {
      "enabled": true,
      "auto_propose": false,
      "require_approval": true,
      "eval_min_gain": 2
    }
  }
}
